<!--
  ============================================================================
  android/app/src/main/AndroidManifest.xml — MANIFIESTO DE ANDROID
  ============================================================================
  Describe la app al sistema Android. Lo tocarás para:
    - Cambiar el NOMBRE VISIBLE bajo el icono        → android:label
    - Añadir PERMISOS (internet, cámara, ubicación…) → <uses-permission>
    - Configurar deep links / App Links               → <intent-filter> en la activity
    - Metadatos que piden algunos plugins (Google Maps API key, etc.)

  Este es el manifiesto "main" (se usa en TODOS los modos, incluido release).
  Hay otros en src/debug/ y src/profile/ que se combinan con este.

  📚 Más: android/README.md · docs/06-construir-la-app.md (sección 9)
  ============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PERMISOS: van aquí, ANTES de <application>. Ejemplos:

      ⚠️ INTERNET: en debug ya viene (src/debug/AndroidManifest.xml), pero en
      RELEASE hay que declararlo aquí si la app usa la red. Descomenta cuando
      tu app consuma una API:
      <uses-permission android:name="android.permission.INTERNET"/>

      <uses-permission android:name="android.permission.CAMERA"/>
      <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    -->

    <application
        android:label="Mi Primera App"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!--
          android:label → nombre que aparece bajo el icono en el teléfono.
          android:icon  → icono (archivos en res/mipmap-*/ic_launcher.png).
                          Para generarlo: paquete flutter_launcher_icons.
        -->

        <!--
          MainActivity: la única pantalla nativa. Flutter dibuja TODA la
          interfaz dentro de ella. Normalmente no se toca.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Tema de Android que se aplica a esta Activity en cuanto arranca el
                 proceso. Se ve mientras se inicializa la interfaz de Flutter y
                 después sigue definiendo el fondo de la ventana detrás de Flutter. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Marca esta Activity como la que se abre al tocar el icono de la app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- No borres este meta-data: la herramienta de Flutter lo usa para
             generar GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Necesario para consultar qué actividades pueden procesar texto. Ver:
         https://developer.android.com/training/package-visibility y
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         En concreto, lo usa el motor de Flutter en io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
